# ============================================================================
# 2-8-9-800 Deployment Inventory  (HGX B300, 800Gb dual-plane)
# ============================================================================
# 2 CSL (CPU/Storage Leaf) switches
# 4 GSL (GPU Spine/Leaf) switches: 2 per plane × 2 planes
# 2 OOB management switches
# ============================================================================

[csl]
csl-[01:02]

[gsl_plane1]
gsl-plane1-[01:02]

[gsl_plane2]
gsl-plane2-[01:02]

[gsl:children]
gsl_plane1
gsl_plane2

[oob]
oob-switch-[01:02]

[nodes]
su-01-node-[01:04]

[support]
bcm-[01:02]
slurm-[01:02]
k8s-[01:03]

[dhcp]
dhcp-oob
dhcp-edge

[oob_server]
oob-server-01

[switches:children]
csl
gsl
oob

[switches:vars]
ansible_user=cumulus
timezone=Etc/UTC
# ansible_password defined in group_vars/switches.yml (references secrets.yml)

[servers:children]
nodes
support
dhcp
oob_server

[servers:vars]
ansible_user=ubuntu
# ansible_password defined in group_vars/servers.yml (references secrets.yml)

[dhcp_config]
dhcp-edge

[dhcp_config:children]
csl
nodes
support

[all]
dhcp-oob

[all:children]
dhcp_config
