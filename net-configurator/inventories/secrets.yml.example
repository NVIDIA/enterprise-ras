# ============================================================================
# Secrets Configuration Template
# ============================================================================
# Copy this file to your deployment's group_vars/all directory:
#   cp inventories/secrets.yml.example inventories/<arch>/group_vars/all/secrets.yml
#
# Then update the values and optionally encrypt with Ansible Vault:
#   ansible-vault encrypt inventories/<arch>/group_vars/all/secrets.yml
# ============================================================================

# -----------------------------------------------------------------------------
# Ansible Connection Passwords
# -----------------------------------------------------------------------------
# Used by Ansible to SSH into devices

# Password for switches (cumulus user)
switch_ansible_password: "CHANGE_ME"

# Password for servers (ubuntu user)
server_ansible_password: "CHANGE_ME"

# -----------------------------------------------------------------------------
# Ansible Become (sudo) Password
# -----------------------------------------------------------------------------
# Used for privilege escalation on remote hosts
# If set, you won't need --ask-become-pass

ansible_become_password: "CHANGE_ME"

# -----------------------------------------------------------------------------
# Switch Configuration Password
# -----------------------------------------------------------------------------
# Password set on switches during ZTP provisioning

switch_password: "CHANGE_ME"

# -----------------------------------------------------------------------------
# LDAP Passwords
# -----------------------------------------------------------------------------
# Used for LDAP server and switch authentication

# LDAP admin/bind password
ldap_admin_password: "CHANGE_ME"

# Default password for LDAP users
ldap_user_default_password: "CHANGE_ME"

# -----------------------------------------------------------------------------
# ZTP Status Page
# -----------------------------------------------------------------------------
# Only used when status_page_enabled=Yes in the Excel Settings tab.

status_page_username: "era"
status_page_password: "CHANGE_ME"

# -----------------------------------------------------------------------------
# NVIDIA Air API Credentials
# -----------------------------------------------------------------------------
# Air credentials live in a SHARED vault, not here. Run:
#
#   make air-setup
#
# to create ~/.config/era-automation/air-secrets.yml (vault-encrypted).
# Every arch/site reads from that single shared vault.
