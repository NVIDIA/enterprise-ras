{# Storage ports are access VLAN 500 on the switch — server sends untagged. #}
{# IP goes directly on bond0 (no VLAN sub-interface). #}
{% set dev = devices[inventory_hostname] %}
{% set ifaces = dev.interfaces | default({}) %}
{# Exclude eth0 — it is the OOB management interface and must not be bonded #}
{% set data_ifaces = ifaces.storage | default(ifaces.cpu | default([])) | reject('equalto', 'eth0') | list %}
{% if data_ifaces | length > 0 or (dev.eth0_ip | default('')) %}
network:
  version: 2
  renderer: networkd
  ethernets:
{% if dev.eth0_ip | default('') %}
{# eth0 is the OOB management interface. It MUST be emitted here: this file
   overwrites /etc/netplan/10-netcfg.yaml (which the Air NI wrote with eth0),
   so omitting eth0 would strip the mgmt IP on `netplan apply` and sever the
   OOB path Ansible connects over. Parity with air-deploy.py::_render_server_netplan. #}
    eth0:
      dhcp4: no
      dhcp6: no
      accept-ra: no
      addresses:
        - {{ dev.eth0_ip }}/24
      routes:
        - to: 0.0.0.0/0
          via: 192.168.200.1
{% endif %}
{% for iface in data_ifaces %}
    {{ iface }}:
      dhcp4: no
      optional: true
{% endfor %}
{% if data_ifaces | length >= 2 and dev.bond_ip1 is defined and dev.bond_ip1 %}
  bonds:
    bond0:
      interfaces:
        - {{ data_ifaces[0] }}
        - {{ data_ifaces[1] }}
      addresses:
        - {{ dev.bond_ip1 }}
      nameservers:
        addresses: [8.8.8.8, 8.8.4.4]
      routing-policy:
        - from: {{ dev.bond_ip1.split('/')[0] }}/32
          table: {{ common.storage_vlan }}
      routes:
        - to: 0.0.0.0/0
          via: {{ common.storage_gateway }}
          table: {{ common.storage_vlan }}
      parameters:
        mode: active-backup
        primary: {{ data_ifaces[0] }}
        mii-monitor-interval: 100
{% if data_ifaces | length >= 4 and dev.bond_ip2 is defined and dev.bond_ip2 %}
    bond1:
      interfaces:
        - {{ data_ifaces[2] }}
        - {{ data_ifaces[3] }}
      addresses:
        - {{ dev.bond_ip2 }}
      nameservers:
        addresses: [8.8.8.8, 8.8.4.4]
      parameters:
        mode: active-backup
        primary: {{ data_ifaces[2] }}
        mii-monitor-interval: 100
{% endif %}
{% endif %}
{% endif %}
