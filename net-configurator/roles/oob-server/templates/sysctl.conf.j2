# /etc/sysctl.conf - OOB Server Configuration
# Managed by Ansible - DO NOT EDIT MANUALLY
#
# This configuration enables IP forwarding and routing for the OOB server
# to act as a gateway for the out-of-band management networks.

# Disable IPv6 (if not needed)
net.ipv6.conf.all.disable_ipv6 = 1
net.ipv6.conf.default.disable_ipv6 = 1
net.ipv6.conf.lo.disable_ipv6 = 1

# Enable IPv4 forwarding (required for routing between networks)
net.ipv4.ip_forward = 1

# Enable IPv6 forwarding (if IPv6 is needed in the future)
net.ipv6.conf.all.forwarding = 1

