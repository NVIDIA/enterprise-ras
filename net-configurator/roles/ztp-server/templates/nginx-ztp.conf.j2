server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/ztp;
    index index.html;

    server_name _;

    # Enable directory listing for debugging
    autoindex on;
    autoindex_exact_size off;
    autoindex_localtime on;

{% if status_page_enabled | default(false) | bool %}
    # Basic auth for external access (status page enabled)
    auth_basic "ERA ZTP Server";
    auth_basic_user_file /etc/nginx/.htpasswd;
{% endif %}

    # ZTP scripts — no auth (switches need unauthenticated access)
    location /scripts/ {
        auth_basic off;
        alias /var/www/ztp/scripts/;
        autoindex on;

        # Add headers for ZTP
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    # Switch configurations — no auth (ZTP downloads these)
    location /configs/ {
        auth_basic off;
        alias /var/www/ztp/configs/;
        autoindex on;
    }

    # Main location (status page)
    location / {
        try_files $uri $uri/ =404;
    }

    # Validation reports — directory listing is HTML, individual files are text
    location /reports/ {
        alias /var/www/ztp/reports/;
        autoindex on;
        charset utf-8;
        types {
            text/plain txt log;
        }
    }

    # Licenses
    location /licenses/ {
        alias /var/www/ztp/licenses/;
        autoindex on;
    }

    # Images (firmware updates)
    location /images/ {
        alias /var/www/ztp/images/;
        autoindex on;
    }

    # Authorized keys for SSH — no auth (ZTP needs this)
    location /authorized_keys {
        auth_basic off;
        alias /var/www/ztp/authorized_keys;
        add_header Content-Type "text/plain";
    }

    # Access logs
    access_log /var/log/nginx/ztp-access.log;
    error_log /var/log/nginx/ztp-error.log;
}

