# Netplan configuration for ZTP interfaces
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# This file configures IP addresses for ZTP server interfaces
# Edit network-config.yml and run 'make ztp-setup' to update

network:
  version: 2
  renderer: networkd
  ethernets:
{% for iface in ztp_interfaces | default([]) %}
    {{ iface.name }}:
      addresses:
        - {{ iface.ip }}/{{ iface.network.split('/')[1] }}
      dhcp4: false
      dhcp6: false
{% endfor %}

