# dnsmasq configuration for ZTP
# Generated by Ansible

{% if ztp_interfaces is defined and ztp_interfaces | length > 0 %}
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MULTI-INTERFACE ZTP CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Listen on multiple interfaces for staged ZTP
{% for iface in ztp_interfaces %}
{% if iface.dnsmasq_listen | default(false) %}
interface={{ iface.name }}  # {{ iface.purpose }} - {{ iface.network }}
{% endif %}
{% endfor %}

{% else %}
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SINGLE-INTERFACE ZTP CONFIGURATION (Legacy)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Listen on specific interface (management network)
interface={{ dnsmasq_interface | default('eth0') }}
{% endif %}

# Don't read /etc/resolv.conf or any other file
no-resolv

# Don't read /etc/hosts
no-hosts

# Upstream DNS servers
server=8.8.8.8
server=8.8.4.4

{% if ztp_interfaces is defined and ztp_interfaces | length > 0 %}
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PER-INTERFACE DHCP RANGES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
{% for iface in ztp_interfaces %}
{% if iface.dnsmasq_listen | default(false) %}
{% set network = iface.network | regex_replace('\.\d+/\d+$', '') %}
{% set gateway = iface.gateway | default(network ~ '.1') %}
# {{ iface.purpose }} - {{ iface.network }}
dhcp-range=interface:{{ iface.name }},{{ network }}.100,{{ network }}.200,12h
dhcp-option=interface:{{ iface.name }},3,{{ gateway }}  # Gateway (OOB server, not ZTP server)
dhcp-option=interface:{{ iface.name }},239,http://{{ iface.ip }}/scripts/ztp.sh  # Cumulus Provision URL (ZTP server)
dhcp-option=interface:{{ iface.name }},66,http://{{ iface.ip }}/cumulus-linux-{{ cumulus_target_release | default('5.15.0') }}.bin  # ONIE Image URL (optional)
{% endif %}
{% endfor %}

{% else %}
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LEGACY DHCP CONFIGURATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DHCP range and lease time
dhcp-range={{ dhcp_range_start | default('192.168.200.100') }},{{ dhcp_range_end | default('192.168.200.200') }},{{ dhcp_lease_time | default('12h') }}

# Gateway
dhcp-option=3,{{ dhcp_gateway | default('192.168.200.1') }}
{% endif %}

# DNS servers (all interfaces)
dhcp-option=6,8.8.8.8,8.8.4.4

# Domain name (all interfaces)
dhcp-option=15,{{ dhcp_domain_name | default('era.local') }}

# Enable TFTP (optional, for future use)
# enable-tftp
# tftp-root=/var/www/ztp

# Log DHCP transactions
log-dhcp

# Log to syslog
log-facility=/var/log/dnsmasq.log

# Don't bind to wildcard address
bind-interfaces

# Enable authoritative mode
dhcp-authoritative

# Read additional configuration from /etc/dnsmasq.d/
conf-dir=/etc/dnsmasq.d/,*.conf

