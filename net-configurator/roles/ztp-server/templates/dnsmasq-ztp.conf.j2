# dnsmasq ZTP configuration - Cumulus Linux
# Generated by Ansible - Switch-specific DHCP entries
# 
# This configuration uses a SINGLE ZTP script for all switches.
# The script extracts the hostname from DHCP and downloads the appropriate config.

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DHCP OPTIONS EXPLAINED
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# DHCP Option 66 (default-url): ONIE installer image URL
#   - Used when switch needs OS upgrade/install
#   - Format: dhcp-option=66,<image-url>
#
# DHCP Option 239 (cumulus-provision-url): ZTP script URL
#   - Downloaded and executed by Cumulus Linux
#   - Format: dhcp-option=239,<script-url>
#
# ALL SWITCHES use the SAME ztp.sh script!
# The script extracts hostname from DHCP and fetches switch-specific config.
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DHCP OPTIONS (DHCP option 66 and 239)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Note: DHCP options 66 (ONIE image) and 239 (ZTP provision URL) are now
#       configured PER-INTERFACE in dnsmasq.conf to support multi-interface ZTP.
#       Each interface advertises its own IP as the ZTP server.
#
# For multi-interface ZTP:
#   - Switches on 192.168.1.x use 192.168.1.8 as ZTP server
#   - Switches on 192.168.200.x use 192.168.200.8 as ZTP server
#   - etc.
#
# This ensures switches always download configs from the correct network interface.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

{% set all_switches = groups['switches'] | default([]) %}
{% if all_switches | length > 0 %}
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SWITCH CONFIGURATIONS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

{% for switch in all_switches %}
{% set switch_vars = hostvars[switch] %}
{% if switch_vars.ansible_host is defined %}
{% set ip_mode = switch_vars.ip_assignment_mode | default('dhcp') %}
{% set has_mac = switch_vars.mac_address is defined and switch_vars.mac_address %}

{% set switch_hostname = switch_vars.hostname | default(switch) %}
# {{ switch }} (hostname: {{ switch_hostname }})
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
{% if ip_mode == 'dhcp' %}
{% if has_mac %}
# Mode: DHCP (MAC-based assignment)
# - ZTP server assigns IP: {{ switch_vars.ansible_host }}
# - Hostname: {{ switch_hostname }}
# - ZTP server IP: (dynamically from DHCP option 239 based on interface)
# - ZTP script: http://<interface-ip>/scripts/ztp.sh
# - Config: http://<interface-ip>/configs/{{ switch_hostname }}-config.sh
dhcp-host={{ switch_vars.mac_address }},{{ switch_hostname }},{{ switch_vars.ansible_host }},12h
{% else %}
# Mode: DHCP (no MAC) - Will get IP from pool
# To assign specific IP, add 'mac_address' to {{ switch }} in inventory
{% endif %}
{% else %}
# Mode: Static IP ({{ switch_vars.ansible_host }})
# - Switch has pre-configured IP
# - Manual ZTP: curl http://<ztp-server-ip>/scripts/ztp.sh | sudo bash
# - Or use: /opt/ztp/manual-ztp.sh {{ switch_hostname }}
{% if has_mac %}
# Providing hostname via DHCP even though IP is static
dhcp-host={{ switch_vars.mac_address }},{{ switch_hostname }},ignore
{% endif %}
{% endif %}

{% endif %}
{% endfor %}
{% endif %}

{% if host_dhcp | default(false) and devices is defined %}
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# HOST DHCP RESERVATIONS (Compute Nodes, Storage, Support Servers)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# Generated from 'devices' dictionary in group_vars/all.yml
# Enabled by: host_dhcp: true
#
# These entries provide DHCP IP reservations for servers/nodes based on
# their MAC addresses. Unlike switches (which get ZTP scripts), these
# devices just get IP assignments.
#

{% for device_name, device_info in devices.items() %}
{% if device_info.mac is defined and device_info.eth0_ip is defined %}
{# Skip switches — they get DHCP reservations from the ZTP section above #}
{% if device_name not in (groups['switches'] | default([])) %}
# {{ device_name }}
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Mode: DHCP (MAC-based reservation for host)
# - MAC: {{ device_info.mac }}
# - IP: {{ device_info.eth0_ip }}
# - Type: Server/Node (not a switch - no ZTP)
dhcp-host={{ device_info.mac }},{{ device_name }},{{ device_info.eth0_ip }},12h

{% endif %}
{% endif %}
{% endfor %}
{% endif %}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# BENEFITS OF THIS APPROACH
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# ✓ ONE ZTP script for all switches (not one per switch)
# ✓ Fleet-wide changes by updating single script
# ✓ Streamlined upgrades - config auto-downloaded after ONIE install
# ✓ ZTP can be re-run any time to apply config changes
# ✓ Scalability - DHCP and HTTP server handle hundreds of switches
# ✓ Config generation decoupled from provisioning
# ✓ Minimal files to manage on ZTP server
#
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

