{% set dev = devices[inventory_hostname] %}
{% set ifaces = dev.interfaces | default({}) %}
{# Exclude eth0 — it is the OOB management interface and must not be bonded #}
{% set cpu_ifaces = ifaces.cpu | default([]) | reject('equalto', 'eth0') | list %}
{% set gpu_ifaces = ifaces.gpu | default([]) | reject('equalto', 'eth0') | list %}
{% set gpu_ips = dev.gpu_ips | default([]) %}
{% set gpu_interfaces = dev.gpu_interfaces | default([]) %}
{% if cpu_ifaces | length > 0 or gpu_ifaces | length > 0 or (dev.eth0_ip | default('')) %}
network:
  version: 2
  renderer: networkd
  ethernets:
{% if dev.eth0_ip | default('') %}
{# eth0 is the OOB management interface. It MUST be emitted here: this file
   overwrites /etc/netplan/10-netcfg.yaml (which the Air NI wrote with eth0),
   so omitting eth0 would strip the mgmt IP on `netplan apply` and sever the
   OOB path Ansible connects over. Parity with air-deploy.py::_render_server_netplan
   (static /24 + default route via the OOB VRR gateway .1; dhcp6/RA off so
   networkd doesn't hang eth0 in `configuring`). #}
    eth0:
      dhcp4: no
      dhcp6: no
      accept-ra: no
      addresses:
        - {{ dev.eth0_ip }}/{{ (common.oob_network | default('192.168.200.0/24')).split('/')[1] }}
      routes:
        - to: 0.0.0.0/0
          via: {{ common.oob_gateway | default('192.168.200.1') }}
{% endif %}
{% for iface in cpu_ifaces %}
    {{ iface }}:
      dhcp4: no
      optional: true
{% endfor %}
{% if gpu_interfaces | length > 0 %}
{# Dual-plane: per-NIC plane-aware IPs + PBR table per NIC #}
{% for gnic in gpu_interfaces %}
    {{ gnic.iface }}:
      dhcp4: no
      optional: true
      addresses:
        - {{ gnic.ip }}
      routing-policy:
        - from: {{ gnic.ip.split('/')[0] }}/32
          table: {{ gnic.table }}
      routes:
        - to: 0.0.0.0/0
          via: {{ gnic.gateway }}
          table: {{ gnic.table }}
{% endfor %}
{% else %}
{# Single-plane: flat gpu_ips list, PBR on first GPU NIC only.
   Address-less GPU NICs (when gpu_ips ran out) get optional:true so
   systemd-networkd-wait-online doesn't block boot waiting on them. #}
{% for iface in gpu_ifaces %}
    {{ iface }}:
      dhcp4: no
      optional: true
{% if loop.index0 < gpu_ips | length %}
      addresses:
        - {{ gpu_ips[loop.index0] }}
{% if loop.index0 == 0 %}
      routing-policy:
        - from: {{ gpu_ips[0].split('/')[0] }}/32
          table: {{ common.gpu_vlan }}
      routes:
        - to: 0.0.0.0/0
          via: {{ common.gpu_gateway }}
          table: {{ common.gpu_vlan }}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
{% if cpu_ifaces | length > 0 and dev.bond_ip is defined and dev.bond_ip %}
  bonds:
    bond0:
      interfaces:
{% for iface in cpu_ifaces %}
        - {{ iface }}
{% endfor %}
      addresses:
        - {{ dev.bond_ip }}
      nameservers:
        addresses: [8.8.8.8, 8.8.4.4]
      routing-policy:
        - from: {{ common.cpu_network }}
          table: {{ common.cpu_vlan }}
      routes:
        - to: 0.0.0.0/0
          via: {{ common.cpu_gateway }}
          table: {{ common.cpu_vlan }}
      parameters:
        mode: active-backup
        primary: {{ cpu_ifaces[0] }}
        mii-monitor-interval: 100
{% endif %}
{% endif %}
