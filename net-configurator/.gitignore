# net-configurator — runtime & local state (this is the public repo root;
# also honored inside the monorepo via nested .gitignore).

# ERA deployment context (user-specific)
.era-context
# Air API credentials vault (per-checkout, vault-encrypted)
# No trailing slash: with one this matches a DIRECTORY only, and
# docs/SECRETS_AND_VAULT.md recommends symlinking this path to share one
# vault between checkouts -- so a symlink here is an expected layout, and
# the slashed form would let `git add -A` commit it. That is exactly what
# happened at the repo root: the committed symlink became self-referential
# on checkout and replaced the real directory.
.era-secrets
# Legacy Air creds test override
.envtest

# Ansible
*.retry
# Local testing
.pytest_cache/
.coverage
htmlcov/
# Python bytecode and virtualenvs. In the monorepo these are covered by the
# root .gitignore, but that file does not ship — in the public tree this
# directory IS the repo root, so they must be listed here too. `make setup`
# creates .venv-test/.
__pycache__/
*.py[cod]
*$py.class
.venv/
.venv-*/
venv/
# Regeneration scratch dirs — never commit (use output/<arch>/<site>/ instead)
/test_output/
/NEW_TESTS/
/playbooks/test_configs/

# Excel files dropped into input/ as a staging area (not committed).
# Sample + largescale shipped example workbooks ARE committed.
input/*.xlsx
input/*.xlsm
!input/sample-*.xlsx
!input/largescale-*.xlsx
input/legacy/
# Non-default input sites (input/<arch>/default/ committed; others ignored).
# input/<arch>/largescale/ is committed too — the shipped reference-scale input
# alongside its reference output/<arch>/largescale/.
input/*/*/
!input/*/default/
!input/*/largescale/

# Non-default output sites. default/ + largescale/ ship as reference output.
output/*/*/
!output/*/default/
!output/*/largescale/
# Volatile output subdirs (regenerated every run)
output/*/default/reports/
output/*/default/topology/node-instructions/
# Validation bundles (ERA-37) — a build artifact, timestamped per run, and it
# lands inside the tracked default/ tree. Never commit one: it is a snapshot of
# a specific deployment, not reference output.
validation-bundle-*.zip
output/*/largescale/reports/
output/*/largescale/topology/node-instructions/
# ERA_DEV_ALLOW_PLACEHOLDER_SECRETS=1 record (ADR-0091) — a local dev run, never reference output.
output/*/*/DEV-PLACEHOLDER-SECRETS.txt

# Completed workbooks are regenerated by `make import` from the authored
# source plus the resolved inventory -- never committed. input/*/default/ and
# input/*/largescale/ are explicitly un-ignored above (that is how the shipped
# workbooks are tracked), so without this a completed copy shows up as
# untracked in exactly the directories we ship from.
input/*/*/*-complete.xlsx

# Converted workbooks are derived artifacts of `make convert-workbook`, which
# writes `<name>.intake.xlsx` beside its source. They regenerate in seconds and
# must not be committed -- two were swept into a commit by a `git add -A`
# during a merge, which is exactly what this rule prevents.
input/*.intake.xlsx
input/*/*/*.intake.xlsx
