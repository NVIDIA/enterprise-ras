# Windows Zone Identifier files (created when downloading files)
*:Zone.Identifier

# ERA deployment context (user-specific, not committed)
.era-context

# Air API credentials (vault-encrypted + optional password file)
.era-secrets/

# Local env override for testing Air API creds (legacy, user-specific)
.envtest

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
.venv-*/
venv/
ENV/
env/
*.egg-info/
.eggs/
dist/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Ansible
*.retry

# Logs
*.log

# Local testing
.pytest_cache/
.coverage
htmlcov/

# Timestamped file backups
archive/

# Release artifacts built by `make release-tarball` (public artifact is nc-v<version>)
/nc-v*.tar.gz
/nc-v*.zip

# Regeneration scratch dirs — never commit (use output/<arch>/<site>/ instead)
/test_output/
/NEW_TESTS/
/playbooks/test_configs/

# Reference architecture PDFs (large binaries, not for version control)
architectural_docs/

# Excel files dropped directly into input/ as a staging area (not committed)
# Run: make import EXCEL=input/<filename>.xlsx
input/*.xlsx
input/*.xlsm
# Exception: sample + shipped example workbooks are committed for testers/public.
# largescale-* = largest verified scale per arch (see docs/ARCH_SUPPORT_MATRIX.md)
# (flat default-*.xlsx stay LOCAL — never synced; the public default template is
#  input/<arch>/default/<arch>.xlsx)
!input/sample-*.xlsx
!input/largescale-*.xlsx
# Local scratch staging (old samples/defs parked here while building new ones)
input/legacy/

# Non-default input sites (user-specific, not committed)
# input/<arch>/default/ is committed; all other site names are ignored
input/*/*/
!input/*/default/

# Non-default output sites (user-specific, not committed)
# output/<arch>/default/ + output/<arch>/largescale/ are committed as public
# reference output; all other site names are ignored.
output/*/*/
!output/*/default/
!output/*/largescale/

# Volatile output subdirs — regenerated every validation/Air run, no value in
# tracking. Only the generated inventory/, configs/, and topology/ (minus
# node-instructions) belong in version control.
output/*/default/reports/
output/*/default/topology/node-instructions/
output/*/largescale/reports/
output/*/largescale/topology/node-instructions/

# Local IDE/agent state
.claude/
.cursorrules
.codex

/images/
