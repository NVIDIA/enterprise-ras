# Files and directories excluded from the public staging sync.
# Used by `make publish-staging` (rsync --exclude-from) and the
# sync-public CI job.  Syntax: rsync filter rules.
# Leading / anchors to the repo root; trailing / means directory only.

# ── Internal tooling ──────────────────────────────────────────────
/.gitlab-ci.yml
/CLAUDE.md
/.claude/
/.codex/
/.cursorrules
/.envtest

# ── Internal docs ─────────────────────────────────────────────────
/docs/ERA-Architecture-Guidelines.md
/docs/TODO-audit-findings.md
/docs/plans/
/docs/requirements/

# ── Internal / test scripts ───────────────────────────────────────
/scripts/run-pipeline-tests.sh

# ── Runtime & generated ───────────────────────────────────────────
/.era-context
/.era-secrets/
/archive/
/architectural_docs/
/logs/
/output/
/.pytest_cache/
/.venv*/
/venv/
__pycache__/
*.pyc
*.pyo

# ── Git internals (never sync) ────────────────────────────────────
/.git/
